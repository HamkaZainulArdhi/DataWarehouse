  <step>
    <name>Alokasi fee</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>fee_komisi</field_name>
      <formula_string>([fee_c]+[fee_s])*[line_total]/[inv_total]</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
