  <order>
    <hop>
      <from>Read trx_header</from>
      <to>Buang VOID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buang VOID</from>
      <to>Sort header</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buang VOID</from>
      <to>Buang (Dummy)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read trx_line</from>
      <to>Sort line</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort header</from>
      <to>Join header+line</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort line</from>
      <to>Join header+line</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read trx_payment</from>
      <to>Sort payment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort payment</from>
      <to>Agregasi payment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregasi payment</from>
      <to>Sort pay_agg</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join header+line</from>
      <to>Join +payment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort pay_agg</from>
      <to>Join +payment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join +payment</from>
      <to>Hitung+S2 norm</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hitung+S2 norm</from>
      <to>Lookup S2 sk_produk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup S2 sk_produk</from>
      <to>Lookup S2 sk_pelanggan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup S2 sk_pelanggan</from>
      <to>Lookup S2 sk_toko</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup S2 sk_toko</from>
      <to>Join HPP S4 S2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join HPP S4 S2</from>
      <to>Finals S2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Finals S2</from>
      <to>Load fact_S2</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Agregasi payment</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory/>
    <prefix/>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>trx_no</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>payment_all</aggregate>
        <subject>method</subject>
        <type>CONCAT_COMMA</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>pay_total</aggregate>
        <subject>amount</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>580</xloc>
      <yloc>540</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Buang (Dummy)</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>580</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Buang VOID</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Sort header</send_true_to>
    <send_false_to>Buang (Dummy)</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>status</leftvalue>
        <function>&lt;></function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>VOID</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>340</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Finals S2</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>hpp_unit</field_name>
      <formula_string>IF(ISBLANK([harga_pokok]);0;[harga_pokok])</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>hpp_total</field_name>
      <formula_string>[qty]*[hpp_unit]</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>fee_komisi</field_name>
      <formula_string>0</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>margin_kotor</field_name>
