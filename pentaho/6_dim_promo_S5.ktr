  <step>
    <name>Buang baris kosong</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Norm kode+diskon</send_true_to>
    <send_false_to>Buang (Dummy)</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>kode_promo</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>kode_promo</leftvalue>
            <function>&lt;></function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
