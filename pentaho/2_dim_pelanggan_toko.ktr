  <step>
    <name>Norm ECOM</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>hp_digits</field_name>
      <formula_string>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([phone];"+";"");" ";"");"-";"");".";"")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>hp_norm62</field_name>
      <formula_string>IF(LEFT([hp_digits];1)="0";CONCATENATE("62";RIGHT([hp_digits];LEN([hp_digits])-1));IF(LEFT([hp_digits];2)="62";[hp_digits];CONCATENATE("62";[hp_digits])))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>tipe</field_name>
      <formula_string>"ECOM"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>kota_std</field_name>
      <formula_string>UPPER(TRIM([city]))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>kota_baku</field_name>
      <formula_string>IF([kota_std]="JAKSEL";"JAKARTA SELATAN";IF([kota_std]="JAKBAR";"JAKARTA BARAT";IF([kota_std]="BDG";"BANDUNG";IF([kota_std]="BKS";"BEKASI";IF([kota_std]="SBY";"SURABAYA";IF([kota_std]="MLG";"MALANG";IF([kota_std]="SMG";"SEMARANG";IF([kota_std]="JOGJA";"YOGYAKARTA";IF([kota_std]="YOGYA";"YOGYAKARTA";IF([kota_std]="MDN";"MEDAN";IF([kota_std]="PLB";"PALEMBANG";IF([kota_std]="MKS";"MAKASSAR";IF([kota_std]="DPS";"DENPASAR";IF(ISBLANK([kota_std]);"UNKNOWN";[kota_std]))))))))))))))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
