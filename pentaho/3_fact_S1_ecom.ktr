  <order>
    <hop>
      <from>Read ECOM order_items</from>
      <to>Hitung exPPN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hitung exPPN</from>
      <to>Lookup sk_produk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup sk_produk</from>
      <to>Lookup sk_pelanggan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup sk_pelanggan</from>
      <to>Lookup sk_toko</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup sk_toko</from>
      <to>Lookup sk_promo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup sk_promo</from>
      <to>Join HPP S4</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join HPP S4</from>
      <to>Finals S1</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Finals S1</from>
      <to>Load fact_S1</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Finals S1</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>hpp_unit</field_name>
      <formula_string>IF(ISBLANK([harga_pokok]);0;[harga_pokok])</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>hpp_total</field_name>
      <formula_string>[qty]*[hpp_unit]</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>fee_komisi</field_name>
      <formula_string>0</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>margin_kotor</field_name>
      <formula_string>[penjualan_bersih]-[hpp_total]-[fee_komisi]</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1780</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Hitung exPPN</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>harga_ex_ppn</field_name>
      <formula_string>[unit_price]/1.11</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>penjualan_bersih</field_name>
      <formula_string>[qty]*[harga_ex_ppn]-[disc_amount]</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>340</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Join HPP S4</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>NRG_DW</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT harga_pokok FROM stg_produk_hpp WHERE material_no = ? AND berlaku_sejak &lt;= ? ORDER BY berlaku_sejak DESC LIMIT 1</sql>
    <outer_join>Y</outer_join>
    <replace_vars>Y</replace_vars>
    <parameter>
      <field>
        <name>material_no</name>
        <type>String</type>
      </field>
      <field>
        <name>order_ymd</name>
        <type>String</type>
      </field>
    </parameter>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1540</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
