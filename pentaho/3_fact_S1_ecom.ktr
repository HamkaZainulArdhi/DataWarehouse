  <step>
    <name>Read ECOM order_items</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>NRG_ECOM</connection>
    <sql>SELECT oi.order_id, oi.line_no, oi.qty, oi.unit_price, oi.disc_amount,
 o.order_ts, o.status, o.payment_method,
 CASE WHEN oi.sku = 'SKU-NEWARR-001' THEN 'UNKNOWN' ELSE CONCAT('P-', SUBSTRING(oi.sku, 5, 4)) END AS material_no,
 hp.hp_norm62, UPPER(TRIM(v.promo_code)) AS kode_norm,
 DATE_FORMAT(o.order_ts, '%Y-%m-%d') AS order_ymd,
 'WEB' AS kanal, 'S1' AS sumber, 'WEB' AS kode_toko
FROM order_items oi
JOIN orders o ON o.order_id=oi.order_id
LEFT JOIN vouchers v ON v.voucher_id=o.voucher_id
LEFT JOIN (
  SELECT customer_id,
    CASE WHEN d.hp LIKE '0%' THEN CONCAT('62', SUBSTRING(d.hp, 2))
         WHEN d.hp LIKE '62%' THEN d.hp
         ELSE CONCAT('62', d.hp) END AS hp_norm62
  FROM (SELECT customer_id,
    REPLACE(REPLACE(REPLACE(REPLACE(phone, '+', ''), ' ', ''), '-', ''), '.', '') AS hp
    FROM customers) d
) hp ON hp.customer_id=o.customer_id
WHERE o.status &lt;&gt; 'DIBATALKAN'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
